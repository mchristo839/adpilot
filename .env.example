# ---- Safety ----
# Default ON. Every Meta write is logged and NOT sent until you set this to false.
DRY_RUN=true

# ---- Meta Marketing API ----
# System User token (never expires). Scopes: ads_management, ads_read,
# business_management, pages_read_engagement, pages_manage_ads, instagram_basic
META_SYSTEM_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
# Business Manager id that owns all ad accounts (used by add-brand.ts checks)
META_BUSINESS_ID=

# ---- Supabase ----
SUPABASE_URL=https://ztpkbgngcnapbvyfeanb.supabase.co
# Service role key. Only the worker and scripts use it. Never ship to the dashboard bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Claude ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL_GENERATE=claude-sonnet-4-6
CLAUDE_MODEL_CLASSIFY=claude-haiku-4-5-20251001

# ---- Images ----
FAL_KEY=
# Where rendered PNGs are written (mounted volume in docker-compose)
STORAGE_DIR=./storage
# Optional: path to a Chromium binary when the bundled Playwright browser is not installed
CHROMIUM_PATH=
# "supabase" (default) uploads rendered PNGs to the public bucket below; "local" serves them from the worker
STORAGE_BACKEND=supabase
SUPABASE_STORAGE_BUCKET=adpilot-creatives
# Public base URL for local mode previews
STORAGE_PUBLIC_URL=http://localhost:8787/files

# ---- Airtable (ClearCyprus creative queue input) ----
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appZxzHV1ywNbLKtS
AIRTABLE_TABLE=ClearCyprus Ad Creative Queue

# ---- Worker API ----
PORT=8787
# Shared secret. n8n and the dashboard send it as `x-api-key`.
WORKER_API_KEY=change-me
# Identities allowed to approve launches. The dashboard sends the logged-in email as x-actor;
# n8n and scripts fall back to the first entry. Comma separated.
ALLOWED_APPROVERS=mario,mario@utomat.com
# Optional: run the monitor from inside the worker when n8n has not called it for this long (ms). 0 disables.
MONITOR_FALLBACK_MS=10800000
# Alert when the last monitor run is older than this many hours
STALE_MONITOR_HOURS=6

# ---- Notifications (n8n webhook that sends email) ----
N8N_NOTIFY_WEBHOOK_URL=https://n8n.utomat.com/webhook/adpilot-notify
DASHBOARD_URL=http://localhost:3000

# ---- Dashboard (apps/dashboard, set these on Vercel) ----
WORKER_URL=http://localhost:8787
# WORKER_API_KEY: same value as above
NEXT_PUBLIC_SUPABASE_URL=https://ztpkbgngcnapbvyfeanb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_okPiKJ9_aZ_lTuU6hN0puw_cAYOYNT9
# Who may log in (magic link). Must also appear in ALLOWED_APPROVERS on the worker.
ALLOWED_EMAILS=mario@utomat.com
# Public URL of the dashboard, used in the magic link redirect
DASHBOARD_URL=http://localhost:3000
